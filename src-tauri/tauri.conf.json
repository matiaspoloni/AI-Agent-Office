{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Office",
  "mainBinaryName": "agent-office",
  "version": "0.1.0",
  "identifier": "com.agentoffice.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Office",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Agent Office",
    "copyright": "Copyright © 2026 Agent Office contributors",
    "category": "DeveloperTool",
    "shortDescription": "Pixel-art office for your AI coding agents",
    "longDescription": "Agent Office shows Claude Code, Codex CLI and Cursor CLI sessions as characters in a pixel-art office.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SpanishInternational"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Agent Office",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
